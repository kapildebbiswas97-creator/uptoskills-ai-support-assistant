{
  "name": "uptoskills-ai-support-assistant",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=127.0.0.1",
    "server": "tsx server/index.ts",
    "seed:knowledge": "tsx server/seed-knowledge.ts",
    "db:mongo:init": "tsx server/initialize-mongodb.ts",
    "db:postgres:migrate": "tsx -e \"import('dotenv/config').then(async()=>{const m=await import('./server/database.ts');const applied=await m.runPostgresMigrations();process.stdout.write(JSON.stringify(applied)+'\\n')})\"",
    "db:postgres:migrate:local": "tsx scripts/migrate-local-postgres.ts",
    "db:postgres:provision-local-rls-key": "tsx scripts/provision-local-rls-key.ts",
    "db:documents:reconcile": "tsx server/reconcile-documents.ts",
    "env:validate": "tsx server/environment.ts",
    "env:validate:staging": "tsx server/environment.ts --staging",
    "build": "npm run check:serverless-esm-graph && npm run lint && vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "check:serverless-esm-graph": "node scripts/check-serverless-esm-graph.mjs",
    "test": "tsx --test --test-concurrency=1 src/utils/assistantEngine.test.ts src/utils/meetingRequest.test.ts serverless/route-path.test.ts server/assistant.test.ts server/app.test.ts server/request-body.test.ts server/auth.test.ts server/ai-provider.test.ts server/model-catalog.test.ts server/verify-routing.test.ts server/knowledge-base.test.ts server/gemini.test.ts server/database.test.ts server/rate-limit.test.ts server/security.test.ts server/document-ingestion.test.ts server/document-ingestion.failure.test.ts server/rag.test.ts server/health.test.ts server/environment.test.ts server/observability.test.ts server/rls-context.test.ts server/escalations.test.ts server/escalation-routes.test.ts server/meeting-requests.test.ts server/meeting-request-routes.test.ts",
    "test:meetings": "tsx --test src/utils/meetingRequest.test.ts server/meeting-requests.test.ts server/meeting-request-routes.test.ts",
    "test:integration:meetings": "tsx --test server/meeting-requests.integration.test.ts",
    "test:integration:rls": "tsx --test server/postgres-rls.integration.test.ts",
    "test:integration:local": "tsx --test server/local-services.integration.test.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "cheerio": "^1.2.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jose": "^6.2.17",
    "lucide-react": "^0.546.0",
    "mammoth": "^1.13.0",
    "mongodb": "^7.9.0",
    "motion": "^12.23.24",
    "pdf-parse": "^2.4.5",
    "pg": "^8.23.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "redis": "^6.3.1",
    "vite": "^8.3.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
