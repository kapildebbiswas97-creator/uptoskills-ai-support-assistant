# Add one or more keys. Keys remain server-side and are never sent to the browser.
# The model picker lists the live model catalog for every configured provider.
OPENROUTER_API_KEY=""
GEMINI_API_KEY=""
GROQ_API_KEY=""
CLOUDFLARE_API_TOKEN=""
CLOUDFLARE_ACCOUNT_ID=""
CEREBRAS_API_KEY=""
NVIDIA_API_KEY=""
MISTRAL_API_KEY=""
REQUESTY_API_KEY=""

# Preferred provider and its default model. The UI can switch between configured providers.
AI_PROVIDER="openrouter"
AI_MODEL="openrouter/free"
# Optional per-provider model defaults; IDs can change, see each live model picker.
# GEMINI_MODEL="gemini-2.5-flash"
# AI_MODEL_GROQ="llama-3.3-70b-versatile"
# AI_MODEL_CLOUDFLARE="@cf/meta/llama-3.3-70b-instruct-fp8-fast"
# AI_MODEL_CEREBRAS="llama-3.3-70b"
# AI_MODEL_NVIDIA="meta/llama-3.3-70b-instruct"
# AI_MODEL_MISTRAL="mistral-small-latest"
# AI_MODEL_REQUESTY="provider/model-id"
# OpenRouter web search is enabled only for research-like prompts when true (may incur a fee).
AI_WEB_SEARCH="false"

# Optional local infrastructure. Chat falls back to knowledge.yaml when these
# services are not running. These values are for local development only.
POSTGRES_ADMIN_PASSWORD="local-dev-admin"
UTS_DB_READER_PASSWORD="local-dev-reader"
DATABASE_ADMIN_URL="postgresql://postgres:local-dev-admin@127.0.0.1:5432/uptoskills"
DATABASE_URL="postgresql://uts_assistant_reader:local-dev-reader@127.0.0.1:5432/uptoskills"
REDIS_PASSWORD="local-dev-redis"
REDIS_URL="redis://:local-dev-redis@127.0.0.1:6379"

