# Add one or more keys. Keys remain server-side and are never sent to the browser.
# The model picker lists the live model catalog for every configured provider.
OPENROUTER_API_KEY=""
GEMINI_API_KEY=""
GROQ_API_KEY=""
CLOUDFLARE_API_TOKEN=""
CLOUDFLARE_ACCOUNT_ID=""
CEREBRAS_API_KEY=""
NVIDIA_API_KEY=""
MISTRAL_API_KEY=""
REQUESTY_API_KEY=""

# Preferred provider and its default model. The UI can switch between configured providers.
AI_PROVIDER="openrouter"
AI_MODEL="openrouter/free"
# Optional per-provider model defaults; IDs can change, see each live model picker.
# GEMINI_MODEL="gemini-2.5-flash"
# AI_MODEL_GROQ="llama-3.3-70b-versatile"
# AI_MODEL_CLOUDFLARE="@cf/meta/llama-3.3-70b-instruct-fp8-fast"
# AI_MODEL_CEREBRAS="llama-3.3-70b"
# AI_MODEL_NVIDIA="meta/llama-3.3-70b-instruct"
# AI_MODEL_MISTRAL="mistral-small-latest"
# AI_MODEL_REQUESTY="provider/model-id"
# OpenRouter web search is enabled only for research-like prompts when true (may incur a fee).
AI_WEB_SEARCH="false"

# Optional local infrastructure. Chat falls back to knowledge.yaml when these
# services are not running. These values are for local development only.
MONGODB_URI=""
MONGODB_DATABASE="uptoskills"

# Supabase Authentication (Browser & Public variables - never commit service-role keys)
VITE_SUPABASE_URL=""
VITE_SUPABASE_PUBLISHABLE_KEY=""

# Supabase & OIDC Token Verification (Server-Only)
# Setting SUPABASE_URL automatically configures the issuer, audience (authenticated),
# and JWKS endpoint (https://<project>.supabase.co/auth/v1/.well-known/jwks.json).
SUPABASE_URL=""
AUTH_ISSUER=""
AUTH_AUDIENCE=""
AUTH_JWKS_URL=""
AUTH_ROLES_CLAIM="roles"
AUTH_TENANT_CLAIM="org_id"
# Map only trusted identity-provider claim values. Do not add support_agent until
# the HR group claim and reviewer policy are explicitly approved; there is no HR default.
AUTH_ROLE_MAPPING='{"super_admin":"super_admin","admin":"admin","knowledge_manager":"knowledge_manager","user":"user"}'
REQUIRE_VERIFIED_EMAIL="true"
# Defaults to disabled on staging / Vercel previews and enabled elsewhere to preserve existing behavior.
# Keep unset or false for staging verification. Anonymous staging access requires an explicit product approval.
ALLOW_ANONYMOUS_CHAT=""
ANONYMOUS_CHAT_APPROVED=""
MALWARE_SCANNER_URL=""
MALWARE_SCANNER_TOKEN=""
DOCUMENT_PARSE_TIMEOUT_MS="10000"
EMBEDDING_PROVIDER="gemini"
EMBEDDING_MODEL="gemini-embedding-2"
EMBEDDING_DIMENSIONS="768"
EMBEDDING_VERSION="1"
POSTGRES_ADMIN_PASSWORD="local-dev-admin"
UTS_DB_READER_PASSWORD="local-dev-reader"
UTS_DB_WRITER_PASSWORD="local-dev-writer"
DATABASE_ADMIN_URL="postgresql://postgres:local-dev-admin@127.0.0.1:5432/uptoskills"
DATABASE_URL="postgresql://uts_assistant_reader:local-dev-reader@127.0.0.1:5432/uptoskills"
DATABASE_INGEST_URL="postgresql://uts_assistant_writer:local-dev-writer@127.0.0.1:5432/uptoskills"
DATABASE_MIGRATION_URL="postgresql://postgres:local-dev-admin@127.0.0.1:5432/uptoskills"
# Set a unique 32-byte base64url key for each environment. Provision the same key ID/value
# into app_private.rls_context_keys with the operator procedure; never commit real keys.
RLS_CONTEXT_KEY_ID=""
RLS_CONTEXT_HMAC_KEY=""
REDIS_PASSWORD="local-dev-redis"
REDIS_URL="redis://:local-dev-redis@127.0.0.1:6379"

