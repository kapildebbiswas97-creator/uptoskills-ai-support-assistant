{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.ts": {
      "maxDuration": 60,
      "includeFiles": "{knowledge.yaml,docs/**}"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path(.*)",
      "destination": "/api/index?__vercelOriginalApiPath=:path"
    }
  ]
}
